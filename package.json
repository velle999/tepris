{
  "name": "tepris",
  "version": "0.1.0",
  "description": "TEPRIS Arcade \u2014 desktop build",
  "main": "main.js",
  "author": "Velle",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder -w"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.velle.tepris",
    "productName": "TEPRIS",
    "files": [
      "app/**",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    }
  }
}